# WeCheckin 钉钉 H5 单独 Docker 部署环境变量示例
# 使用前复制为 dingtalk-h5/.env，并按实际后端地址、域名和 CorpId 修改。

DINGTALK_H5_IMAGE=wecheckin-dingtalk-h5:latest
DINGTALK_H5_CONTAINER_NAME=wecheckin-dingtalk-h5
DINGTALK_H5_HTTP_PORT=8086

# 默认留空，前端请求保持 /api/v2 同源路径，由本容器 Nginx 代理到后端。
# 如果要构建为直连独立 API 域名，可填写 https://api.example.com。
VITE_API_BASE_URL=
VITE_DINGTALK_CORP_ID=

NGINX_SERVER_NAME=_
NGINX_CLIENT_MAX_BODY_SIZE=32m
NGINX_API_PROXY_TARGET=http://host.docker.internal:8083

DINGTALK_H5_LOG_MAX_SIZE=20m
DINGTALK_H5_LOG_MAX_FILE=5
