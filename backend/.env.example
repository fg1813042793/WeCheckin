# WeCheckin Docker Compose 环境变量示例
# 使用前复制为 backend/.env，并修改所有密码和域名。

MYSQL_ROOT_PASSWORD=change-root-password

WECHECKIN_SERVER_PORT=8083
WECHECKIN_SERVER_MODE=release
# 逗号分隔的受信任反向代理 CIDR。保留历史变量名，但会统一影响访问日志、登录会话、审计日志和业务 IP 字段。
# 示例：127.0.0.1/32,::1/128,172.18.0.0/16。必须按实际代理网络配置，不能填写 0.0.0.0/0 或 ::/0。
WECHECKIN_SERVER_AUDIT_TRUSTED_PROXY_CIDRS=
WECHECKIN_DATABASE_HOST=mysql
WECHECKIN_DATABASE_PORT=3306
WECHECKIN_DATABASE_USER=wecheckin
WECHECKIN_DATABASE_PASSWORD=change-db-password
WECHECKIN_DATABASE_DBNAME=wecheckin
WECHECKIN_REDIS_HOST=redis
WECHECKIN_REDIS_PORT=6379
WECHECKIN_REDIS_PASSWORD=change-redis-password
WECHECKIN_REDIS_DB=0
# Cron 正常扫描宽限，必须不小于 scheduler poll；仓库配置为 60 秒。
WECHECKIN_SCHEDULED_TASK_MISFIRE_GRACE_SECONDS=60
WECHECKIN_CORS_ALLOW_ORIGINS=https://your-domain.example

# 慢请求日志阈值，单位毫秒；超过后额外输出 [SLOW_REQUEST]，只记录 route 元数据，不记录请求体。
WECHECKIN_SLOW_REQUEST_MS=800

# Docker json-file 日志轮转，避免容器日志无限增长。
WECHECKIN_LOG_MAX_SIZE=20m
WECHECKIN_LOG_MAX_FILE=5
