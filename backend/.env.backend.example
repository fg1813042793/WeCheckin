# WeCheckin backend-only Docker Compose 环境变量示例
# 使用前复制为 backend/.env，并按实际部署修改数据库、Redis、CORS 和镜像配置。

WECHECKIN_BACKEND_IMAGE=wecheckin-backend:latest
WECHECKIN_BACKEND_CONTAINER_NAME=wecheckin-backend
WECHECKIN_BACKEND_HTTP_PORT=8083

APP_ENV=production
GIN_MODE=release
WECHECKIN_SERVER_PORT=8083
WECHECKIN_SERVER_MODE=release

# 单独部署 backend 时，MySQL 通常在宿主机或外部数据库。
# 宿主机 MySQL 可使用 host.docker.internal；Linux 下 Compose 已配置 host-gateway。
WECHECKIN_DATABASE_HOST=host.docker.internal
WECHECKIN_DATABASE_PORT=3306
WECHECKIN_DATABASE_USER=wecheckin
WECHECKIN_DATABASE_PASSWORD=change-db-password
WECHECKIN_DATABASE_DBNAME=wecheckin

# Redis 可为空密码；如果 Redis 有密码，请填写 WECHECKIN_REDIS_PASSWORD。
WECHECKIN_REDIS_HOST=host.docker.internal
WECHECKIN_REDIS_PORT=6379
WECHECKIN_REDIS_PASSWORD=
WECHECKIN_REDIS_DB=0

# 生产环境建议改为管理后台、客户端、钉钉 H5 的真实域名，多个域名用英文逗号分隔。
WECHECKIN_CORS_ALLOW_ORIGINS=https://your-domain.example

WECHECKIN_LOG_DIR=/root/logs
WECHECKIN_LOG_LEVEL=info
WECHECKIN_LOG_MAX_AGE=30
WECHECKIN_LOG_COMPRESS=true
WECHECKIN_LOG_MAX_SIZE=20m
WECHECKIN_LOG_MAX_FILE=5

WECHECKIN_UPLOADS_DIR=./uploads
WECHECKIN_LOGS_DIR=./logs
