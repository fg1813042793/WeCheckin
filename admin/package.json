    "axios": "^1.7.9",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "element-plus": "^2.9.7",
    "highlight.js": "^11.12.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
