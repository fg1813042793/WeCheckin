# uni-app 客户端后端 API 地址
# 本地 H5 调试通常使用 http://localhost:8083
# 真机/小程序调试请改成设备可访问的局域网、测试环境或生产环境地址
VITE_API_BASE_URL=http://localhost:8083

# H5 OAuth 回调地址；留空时回到当前 H5 站点。
VITE_DINGTALK_OAUTH_REDIRECT_URI=

# Android Native Auth SDK 的 redirectUri，仅用于与钉钉开放平台回调域名匹配，不负责页面跳转。
# 留空时使用 VITE_API_BASE_URL；开发环境可使用 HTTP，生产环境建议使用 HTTPS。
VITE_DINGTALK_NATIVE_REDIRECT_URI=
