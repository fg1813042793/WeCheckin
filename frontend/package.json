{
  "name": "wecheckin",
  "version": "1.0.0",
  "description": "MY打卡 - 多功能打卡应用",
  "main": "main.js",
  "scripts": {
    "dev:h5": "UNI_INPUT_DIR=. uni --platform h5",
    "dev:app": "UNI_INPUT_DIR=. uni --platform app",
    "dev:mp-weixin": "UNI_INPUT_DIR=. uni --platform mp-weixin",
    "build:h5": "UNI_INPUT_DIR=. uni build --platform h5",
    "build:app": "UNI_INPUT_DIR=. uni build --platform app",
    "build:mp-weixin": "UNI_INPUT_DIR=. uni build --platform mp-weixin",
    "check:config": "node scripts/check-config.mjs",
    "check:request": "node scripts/check-request.mjs && node scripts/check-client-api-v2.mjs && node scripts/check-request-dedupe.mjs && node --no-warnings scripts/check-latest-request.mjs",
    "check:logs": "node scripts/check-production-logs.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "check:dingtalk-login": "node --no-warnings scripts/check-dingtalk-login.mjs",
    "check:dingtalk-native-auth": "node scripts/check-dingtalk-native-auth.mjs",
    "check:formkit-logic": "node scripts/check-formkit-logic.mjs",
    "check:form-fill": "node --no-warnings scripts/check-form-fill.mjs",
    "check:upload": "node scripts/check-upload.mjs",
    "check:platform": "node scripts/check-platform-boundaries.mjs",
    "check:news-search-layout": "node scripts/check-news-search-layout.mjs",
    "check:fixed-list-headers": "node scripts/check-fixed-list-headers.mjs",
    "check:search-input-style": "node scripts/check-search-input-style.mjs",
    "check:request-dedupe": "node scripts/check-request-dedupe.mjs",
    "check:list-render-performance": "node scripts/check-list-render-performance.mjs",
    "check:all": "npm run check:config && npm run check:request && npm run check:logs && npm run check:auth && npm run check:dingtalk-login && npm run check:dingtalk-native-auth && npm run check:formkit-logic && npm run check:form-fill && npm run check:upload && npm run check:platform && npm run check:news-search-layout && npm run check:fixed-list-headers && npm run check:search-input-style && npm run check:list-render-performance"
  },
  "dependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-app": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-uts-v1": "3.0.0-alpha-5020120260710001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020120260710001",
    "sass": "^1.101.0",
    "vite": "^5.0.0"
  }
}
