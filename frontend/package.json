{
  "name": "wecheckin",
  "version": "1.0.0",
  "description": "MY打卡 - 多功能打卡应用",
  "main": "main.js",
  "scripts": {
    "dev:h5": "UNI_INPUT_DIR=. uni --platform h5",
    "dev:app": "UNI_INPUT_DIR=. uni --platform app",
    "dev:mp-weixin": "UNI_INPUT_DIR=. uni --platform mp-weixin",
    "build:h5": "UNI_INPUT_DIR=. uni build --platform h5",
    "build:app": "UNI_INPUT_DIR=. uni build --platform app",
    "build:mp-weixin": "UNI_INPUT_DIR=. uni build --platform mp-weixin",
    "check:config": "node scripts/check-config.mjs",
    "check:request": "node scripts/check-request.mjs",
    "check:logs": "node scripts/check-production-logs.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "check:formkit-logic": "node scripts/check-formkit-logic.mjs"
  },
  "dependencies": {
    "vue": "^3.3.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-app": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020120260710001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020120260710001",
    "sass": "^1.101.0",
    "vite": "^5.0.0"
  }
}
