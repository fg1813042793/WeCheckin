{
    "schemaVersion": 1,
    "key": "IC-123-Amy",
    "name": "IC-特殊版-Amy",
    "displayName": "绩效考评单",
    "instanceIdentity": {
        "titleTemplate": "{{businessPeriod}}-{{starterName}}提交的{{displayName}}",
        "businessPeriod": {
            "enabled": true,
            "granularity": "month",
            "source": "availability_window_start"
        }
    },
    "form": [
        {
            "key": "field_1",
            "label": "本月目标",
            "type": "detail_list",
            "required": true,
            "span": 24,
            "rowKey": "id",
            "columns": [
                {
                    "key": "target",
                    "label": "目标",
                    "type": "textarea",
                    "required": true,
                    "maxLength": 200,
                    "span": 24,
                    "minVisibleRows": 2,
                    "maxVisibleRows": 6
                },
                {
                    "key": "weight",
                    "label": "权重",
                    "type": "number",
                    "required": true,
                    "min": 0,
                    "max": 100,
                    "span": 12
                },
                {
                    "key": "completion",
                    "label": "完成度",
                    "type": "number",
                    "min": 0,
                    "max": 150,
                    "span": 12
                },
                {
                    "key": "result",
                    "label": "结果自评",
                    "type": "textarea",
                    "maxLength": 1000,
                    "span": 24,
                    "minVisibleRows": 5,
                    "maxVisibleRows": 6
                }
            ],
            "maxRows": 20,
            "rules": [
                {
                    "id": "rule_1788773330534_1",
                    "type": "column_sum",
                    "column": "weight",
                    "operator": "lte",
                    "value": 100
                }
            ]
        },
        {
            "key": "field_2",
            "label": "目标得分",
            "type": "calculation",
            "span": 24,
            "calculation": {
                "expression": "SUM([field_1.weight] * [field_1.completion])/100",
                "display": "label",
                "precision": 2
            }
        },
        {
            "key": "field_3",
            "label": "思考总结",
            "type": "textarea",
            "required": true,
            "maxLength": 5000,
            "span": 24,
            "minVisibleRows": 8,
            "maxVisibleRows": 15
        },
        {
            "key": "field_4",
            "label": "下月目标",
            "type": "detail_list",
            "required": true,
            "span": 24,
            "rowKey": "id",
